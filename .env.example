# Публичный домен контроллера (без слэша на конце)
OMC_PUBLIC_URL=https://example.com

# База данных PostgreSQL (для docker-compose менять не нужно, кроме пароля)
OMC_DATABASE_URL=postgresql+asyncpg://omc:CHANGE_ME_DB_PASS@db:5432/omc
POSTGRES_DB=omc
POSTGRES_USER=omc
POSTGRES_PASSWORD=CHANGE_ME_DB_PASS

# Redis
OMC_REDIS_URL=redis://redis:6379/0

# Секретный ключ для подписи JWT (сгенерировать: openssl rand -hex 32)
OMC_JWT_SECRET=CHANGE_ME_RANDOM_HEX_64_CHARS
OMC_JWT_ACCESS_TTL_SEC=900
OMC_REFRESH_TTL_DAYS=30

# Ключ шифрования токенов 3x-ui и паролей нод в БД
# Сгенерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OMC_FERNET_KEY=CHANGE_ME_FERNET_KEY

# Доверенные прокси для корректного определения IP клиента за Nginx/Docker
OMC_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","172.16.0.0/12","10.0.0.0/8"]

# Лимиты по умолчанию и интервал опроса статистики (в секундах)
OMC_DEFAULT_MAX_DEVICES=3
OMC_STATS_INTERVAL_SEC=300

# Платёжная система Platega (https://platega.io)
OMC_PLATEGA_BASE_URL=https://platega.io
OMC_PLATEGA_MERCHANT_ID=
OMC_PLATEGA_SECRET=
OMC_PLATEGA_SUCCESS_STATUSES=["CONFIRMED"]
