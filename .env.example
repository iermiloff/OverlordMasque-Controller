# Основные настройки
APP_NAME=OverlordMasque Controller
DATABASE_URL=sqlite:///./controller.db

# Fernet-ключ для шифрования паролей и токенов в БД.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME

# JWT-секрет для сессий приложения.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_DAYS=7

# Учётка админа (создаётся при первом запуске, если не существует)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now

# Логирование
LOG_LEVEL=INFO
